# Copy this file to `.env` and fill in real values. The gateway reads these
# from the process environment at startup (a minimal .env loader in
# gateway/config.py supports this file if present).

# Comma or space separated list of Telegram numeric user ids allowed to talk
# to the gateway. This is the ACL boundary, so make it exact.
ALLOWED_USERS=

# Filesystem path of the Prime Agent daemon's local JSONL-framed socket.
# Daemon/client RPC is implemented in Epic 1 (Task 1.1); this just declares
# the path the client will connect to.
DAEMON_SOCKET_PATH=/tmp/pa-daemon.sock

# Telegram bot token from @BotFather. Leave empty for local/placeholder runs.
BOT_TOKEN=